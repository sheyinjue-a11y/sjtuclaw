# Copy to .env and set the API key locally. Never commit the real key.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TOOL_MODE=native
SJTUCLAW_DATA_DIR=.sjtuclaw
DEEPSEEK_TOKENIZER_PATH=vendor/deepseek-v4-flash-tokenizer
TOOL_ROOT=.
TOOL_MAX_FILE_BYTES=3145728

AGENT_MAX_STEPS=20
AGENT_REPEAT_CALL_LIMIT=5

MODEL_CONTEXT_WINDOW_TOKENS=auto
COMPACTION_TRIGGER_TOKENS=65536
COMPACTION_TARGET_TOKENS=32768
COMPACTION_KEEP_RECENT_TURNS=4
LLM_OUTPUT_RESERVE_TOKENS=8192
MEMORY_RETRIEVAL_LIMIT=8
MEMORY_CONTEXT_MAX_TOKENS=2048

TOKEN_COUNTER_MODE=deepseek
